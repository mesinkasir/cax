---
layout: default.cax
title: All Tags Collections
description: Explore All Tags
---
    <main class="container mt-3">
        <div class="row justify-content-center">
            <div class="col-lg-12 p-5 text-center">                
                <div class="card shadow-sm mt-3 p-5">
                <h1 class="fw-bold display-5 mb-3"><a href="{{url}}">{{title}}</a></h1>
                <p class="mb-5">{{description}}</p>
                    <p>{% for tag in tags %}
                    <a href="/tags/{{ tag.name }}/" class="btn mt-1 mb-1 btn-primary rounded-pill">
                        #{{ tag.name }}
                    </a>
                    {% endfor %}</p>
                </div>
            </div>
        </div>
    </main>